netlink: fix use-after-free in transaction_complete()

transaction_complete() removed the transaction from the hash table
BEFORE calling tr->completion_fn. The remove runs the hash table's
value-destroy (transaction_free -> g_slice_free(tr)), so every
completion dereferenced freed memory. It usually survives on stale
heap and only faults when the chunk is recycled - on a OnePlus 6T
(sdm845, QRTR/qcom-soc) it SIGSEGVs ModemManager on every muxed
(qmapmux) data connection, crash-looping the daemon. Present in
1.24.2 and master (d776ea38); verified fixed on device.

Also parses NLMSG_ERROR payloads from the message actually being
processed (hdr) instead of always the first message in the buffer,
and guards the timeout/completion race.
--- a/src/mm-netlink.c	2026-09-12 22:31:27.693135151 +0100
+++ b/src/mm-netlink.c	2026-09-12 21:54:22.923488308 +0100
@@ -233,13 +233,18 @@
     task = g_steal_pointer (&tr->completion_task);
     sequence_id = tr->sequence_id;
 
-    g_hash_table_remove (tr->self->transactions,
-                         GUINT_TO_POINTER (tr->sequence_id));
+    if (!task)
+        /* Transaction already completed elsewhere (e.g. timeout raced us) */
+        return;
 
     if (!saved_errno) {
         GError *error = NULL;
 
-        if (!tr->completion_fn (task, hdr, &error))
+        if (!tr->completion_fn)
+            g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED,
+                                     "Netlink transaction %u has no completion callback",
+                                     sequence_id);
+        else if (!tr->completion_fn (task, hdr, &error))
             g_task_return_error (task, error);
     } else {
         g_task_return_new_error (task, G_IO_ERROR, g_io_error_from_errno (saved_errno),
@@ -247,9 +252,17 @@
                                  sequence_id);
     }
 
+    /* Remove only after the completion callback has run: the remove triggers
+     * transaction_free() via the destroy notify, which frees tr — reading
+     * tr->completion_fn afterwards would be a use-after-free.
+     */
+    g_hash_table_remove (tr->self->transactions,
+                         GUINT_TO_POINTER (tr->sequence_id));
+
     g_object_unref (task);
 }
 
+
 static void
 transaction_free (Transaction *tr)
 {
@@ -522,7 +535,7 @@
 
         switch (hdr->nlmsg_type) {
         case NLMSG_ERROR:
-            err = NLMSG_DATA (buf);
+            err = NLMSG_DATA (hdr);
             nlerr = err->error;
             break;
         case RTM_NEWLINK:
