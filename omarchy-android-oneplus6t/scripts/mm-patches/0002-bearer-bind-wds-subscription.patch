+static void
+bind_subscription_ready (QmiClientWds *client,
+                         GAsyncResult *res,
+                         GTask        *task)
+{
+    ConnectContext                                     *ctx;
+    GError                                             *error = NULL;
+    g_autoptr(QmiMessageWdsBindSubscriptionOutput)      output = NULL;
+    MMBearerQmi                                        *self;
+
+    ctx  = g_task_get_task_data (task);
+    self = MM_BEARER_QMI (g_task_get_source_object (task));
+
+    output = qmi_client_wds_bind_subscription_finish (client, res, &error);
+    if (!output || !qmi_message_wds_bind_subscription_output_get_result (output, &error)) {
+        /* Not all firmwares support (or need) this call; never fatal.
+         * Needed e.g. on SDM845+IPA devices where the call manager must
+         * be told which subscription (SIM session) the data client targets. */
+        mm_obj_warn (self, "WDS bind subscription failed: %s (continuing)", error->message);
+        g_error_free (error);
+        ctx->step++;
+        connect_context_step (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "WDS client bound to primary subscription");
+    ctx->step++;
+    connect_context_step (task);
+}
