[Unit]
Description=Voice call audio daemon (q6voiced, postmarketOS)
Documentation=https://gitlab.com/postmarketOS/q6voiced
After=ModemManager.service
# BindsTo + WantedBy=ModemManager.service, deliberately, so the lifecycle is
# symmetric: q6voiced dies with MM (its DBus signal source) and comes back when
# MM does. PartOf alone propagates only *stop*, so one `systemctl restart
# ModemManager` (or an MM crash) left call audio silently dead until reboot.
BindsTo=ModemManager.service

[Service]
Type=simple
# q6voiced takes the PCM device as its only argument (no config file; the
# /etc/conf.d/q6voiced in pmOS is their OpenRC wrapper's convention).
# hw:0,6 = card 0 (O6T) device 6 (VoiceMMode1), see ls /dev/snd/by-path and
# the card's PCM list. Backend routing (earpiece + bottom mic) is done by the
# UCM "Voice Call" verb, flipped by fajita-call-watch on the user side.
ExecStart=/usr/local/bin/q6voiced hw:0,6
Restart=on-failure
RestartSec=2

[Install]
WantedBy=ModemManager.service
