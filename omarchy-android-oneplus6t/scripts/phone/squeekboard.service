[Unit]
Description=On-screen keyboard (squeekboard, primed for Hyprland's IME relay)
PartOf=graphical-session.target
After=graphical-session.target
# never loop: a broken start must stay broken rather than spawn primer terminals forever
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
# GTK colours from the current Omarchy theme, regenerated by fajita-osk-theme
# (theme-set hook). Without this squeekboard stays Adwaita grey.
Environment=GTK_THEME=FajitaOsk
# Heal the global OSK gate. The screensaver flips
# org.gnome.desktop.a11y.applications screen-keyboard-enabled to false while it
# renders (squeekboard will not map a panel while it is false) and restores it
# on every exit path. A SIGKILL or power cut mid-render would leave it false,
# and this phone has no physical keyboard to recover with, so every session
# start puts it back unconditionally.
# `-` prefix: a nonzero exit here (dconf not ready this early, schema missing)
# must not fail the unit — with StartLimitBurst=3 that would leave squeekboard
# dead, which is the no-keyboard outcome this line exists to prevent.
ExecStartPre=-/usr/bin/gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled true
ExecStart=%h/.local/bin/fajita-osk-start
ExecStopPost=%h/.local/bin/fajita-osk-primer close
Restart=on-failure
RestartSec=10
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
