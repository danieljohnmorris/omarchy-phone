// Second bar row for the phone: the OnePlus 6T's teardrop notch sits dead centre
// of the top bar, so the clock is unreadable there. Omarchy's own bar stays as
// row one; this sits directly underneath it and carries the time and battery.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  // Omarchy's bar reserves its own space, so no margin is needed to sit below it.
  "margin-top": 0,
  "spacing": 12,
  "modules-left": ["battery"],
  "modules-center": ["clock"],
  "modules-right": ["clock#date"],
  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "tooltip": false
  },
  // A second clock instance rather than a custom `date` exec: the phone has no
  // RTC, so waybar starts in 1970 and the custom module kept showing "Thu 1 Jan"
  // long after NTP set the clock. The clock module tracks the jump.
  "clock#date": {
    "interval": 60,
    "format": "{:%a %e %b}",
    "tooltip": false
  },
  "battery": {
    "bat": "bq27411-0",
    "format": "{icon} {capacity}%",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "format-charging": "\uf0e7 {capacity}%",
    "format-plugged": "\uf1e6 {capacity}%",
    "tooltip": false
  }
}
