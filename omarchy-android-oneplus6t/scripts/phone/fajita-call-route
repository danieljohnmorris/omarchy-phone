#!/bin/bash
# Switch the live call's audio route: earpiece | speaker | headset.
#
# The hostless VoiceMMode1 FE (opened by q6voiced) feeds whichever AFE ports
# have "<port> Voice Mixer VoiceMMode1" enabled, so a route change is pure
# mixer work — no profile flip, no host PCM. The codec side needs the muxes
# from the UCM verbs (sdm845-mainline alsa-ucm-conf): Earpiece and Headphones
# SectionDevices. The TFA speaker amp has no kcontrols; it powers with the
# QUAT_MI2S link. Headset switches the uplink to the headset mic
# (SLIMBUS_2_TX / AIF3 / ADC2), mirroring the HiFi verb's Headset device.
#
#   fajita-call-route earpiece|speaker|headset   switch
#   fajita-call-route query                      print active route
set -euo pipefail

vx()  { amixer -c0 -q cset name="'$1 Voice Mixer VoiceMMode1'" "$2"; }
cap() { amixer -c0 -q cset name="'VoiceMMode1 Capture Mixer $1'" "$2"; }
cx()  { amixer -c0 -q cset name="$1" "$2"; }

case "${1:-query}" in
  earpiece)
    vx  SLIMBUS_0_RX on;  vx SLIMBUS_1_RX off; vx QUAT_MI2S_RX off
    cap SLIMBUS_0_TX on;  cap SLIMBUS_2_TX off
    cx 'SLIM RX0 MUX' AIF1_PB
    cx 'RX INT0 DEM MUX' CLSH_DSM_OUT
    cx 'RX INT0_1 MIX1 INP0' RX0
    ;;
  speaker)
    vx  QUAT_MI2S_RX on;  vx SLIMBUS_0_RX off; vx SLIMBUS_1_RX off
    cap SLIMBUS_0_TX on;  cap SLIMBUS_2_TX off
    ;;
  headset)
    vx  SLIMBUS_1_RX on;  vx SLIMBUS_0_RX off; vx QUAT_MI2S_RX off
    cap SLIMBUS_2_TX on;  cap SLIMBUS_0_TX off
    cx 'SLIM RX2 MUX' AIF2_PB
    cx 'SLIM RX3 MUX' AIF2_PB
    cx 'RX INT1 DEM MUX' CLSH_DSM_OUT
    cx 'RX INT2 DEM MUX' CLSH_DSM_OUT
    cx 'RX INT1_1 MIX1 INP0' RX2
    cx 'RX INT2_1 MIX1 INP0' RX3
    cx 'COMP1 Switch' 1
    cx 'COMP2 Switch' 1
    cx 'AIF3_CAP Mixer SLIM TX0' 1
    cx 'CDC_IF TX0 MUX' DEC0
    cx 'ADC MUX0' AMIC
    cx 'AMIC MUX0' ADC2
    ;;
  query)
    for r in "SLIMBUS_0_RX:earpiece" "QUAT_MI2S_RX:speaker" "SLIMBUS_1_RX:headset"; do
      port=${r%%:*}; name=${r##*:}
      v=$(amixer -c0 cget name="'$port Voice Mixer VoiceMMode1'" |
        sed -n 's/.*: values=//p')
      if [ "$v" = on ]; then echo "$name"; exit 0; fi
    done
    echo none
    ;;
  *)
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
