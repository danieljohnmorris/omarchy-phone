#!/bin/bash
# Tap action for the cellular bar widget: toggle the data connection.
#
# NetworkManager owns the qmapmux data path (gsm profile "three"). Raw mmcli
# bearers come up TX-only on this modem (downlink never flows), so always go
# through NM. sudo -n: polkit denies activation from session-less callers
# (ssh, systemd-run shells), and the sudoers rule already covers nmcli.
if nmcli -t -f GENERAL.STATE connection show three 2>/dev/null | grep -q activated; then
  sudo -n nmcli connection down three
else
  sudo -n nmcli connection up three
fi
