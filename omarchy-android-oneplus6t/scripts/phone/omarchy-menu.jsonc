{
  // ~/.config/omarchy/extensions/omarchy-menu.jsonc on the phone.
  // Merged over Omarchy's default menu by id; these rows join System.
  // Suspend is masked (s2idle never resumes). Same row, panel off instead.
  "system.suspend": {
    "icon": "󰒲",
    "label": "Screen off",
    "description": "Panel off, power key wakes it",
    "when": "true",
    "action": "fajita-screen-off"
  },
  // Lock: the concept-shell lock screen (swipe up to unlock), not the session
  // lock — no keyboard can render above ext-session-lock, so the password
  // flow is unusable on touch. See README "Lock screen".
  "system.lock": {
    "icon": "󰌾",
    "label": "Lock",
    "description": "Lock screen, swipe up to unlock",
    "action": "$HOME/.local/bin/fajita-lock-screen"
  },

  // Closing apps on touch: no titlebar buttons and hyprgrass is unavailable,
  // so the menu (reachable from the power key or top-left) is the close path.
  // Tap the app to focus it, then this row. Dispatcher form is the Lua-fluent
  // one — this Hyprland evals dispatch args as Lua.
  "system.closeapp": {
    "icon": "󰅖",
    "label": "Close app",
    "description": "Close the focused window",
    "when": "true",
    "action": "hyprctl dispatch 'hl.dsp.window.close()'"
  },
  // Shutdown row: upstream's, shown as-is (systemctl poweroff is passwordless
  // via 50-fajita-power.rules). The OPH-16 trap is unchanged: after a clean
  // poweroff the power key alone will not cold-start the device; recovery is
  // charger attach, a 20-25 s Power hold, or the fastboot combo. README has
  // the details.

  // Theme, normally under Style, mirrored into System so it is reachable from
  // the power key: fajita-power-key opens `omarchy-menu toggle system`, which
  // is the only menu a phone with no keyboard can summon. Same action as
  // Omarchy's style.theme row; the id prefix is what puts it in this group.
  "system.theme": {
    "icon": "\udb83\ude0c",
    "label": "Theme",
    "description": "Wallpaper previews, tap to apply",
    "action": "theme=$(omarchy-theme-switcher); [[ -n $theme ]] && omarchy-theme-set \"$theme\""
  },
  "system.bootloader": {
    "icon": "󰚥",
    "label": "Reboot to bootloader",
    "description": "Fastboot mode, for flashing from the host",
    "action": "fajita-reboot-bootloader"
  }
}
