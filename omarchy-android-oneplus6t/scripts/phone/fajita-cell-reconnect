#!/bin/bash
# Bar menu "Reconnect": bounce the cellular data connection.
# NM profile first (also re-runs MM's connect path cleanly); the raw
# simple-connect fallback covers the profile being missing. sudo -n: the
# shell's execDetached context is denied NM control by polkit (same trap
# fajita-cell-toggle hit), and NOPASSWD covers nmcli/mmcli.
sudo -n nmcli connection down three >/dev/null 2>&1
sudo -n nmcli connection up three >/dev/null 2>&1 \
  || sudo -n mmcli -m any --simple-connect="apn=three.co.uk,ip-type=ipv4v6" >/dev/null 2>&1
