[Desktop Entry]
Version=1.0
Type=Application
Name=Messages
GenericName=SMS
Comment=Read and send SMS over ModemManager
# fajita-app focuses an existing window, else verifies a fresh one maps: a
# plain `ipc call … show || spawn` is answered by a windowless corpse after a
# shell restart and the app never appears.
Exec=fajita-app messages
Icon=mail-message-new
Terminal=false
StartupNotify=true
StartupWMClass=org.quickshell
Categories=Network;Telephony;InstantMessaging;
