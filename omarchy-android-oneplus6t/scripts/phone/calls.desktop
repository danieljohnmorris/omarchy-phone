[Desktop Entry]
Version=1.0
Type=Application
Name=Calls
GenericName=Dialer
Comment=Dial, answer and hang up over ModemManager
# fajita-app focuses an existing window, else verifies a fresh one maps: a
# plain `ipc call … show || spawn` is answered by a windowless corpse after a
# shell restart and the app never appears.
Exec=fajita-app calls
Icon=call-start
Terminal=false
StartupNotify=true
StartupWMClass=org.quickshell
Categories=Network;Telephony;
