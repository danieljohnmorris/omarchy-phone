#!/bin/bash
# Start squeekboard so Hyprland's input-method relay actually routes to it.
#
# Hyprland 0.56.2: an IME that binds while no text-input client is focused
# never receives activate() for the rest of the session, and an IME spawned by
# Hyprland's own exec never works at all (verified 3/3 each way). So open a
# throwaway terminal, wait until it holds focus, then exec squeekboard here so
# this script BECOMES squeekboard (one process, no respawn loop). A background
# subshell closes the primer once squeekboard has bound.
set -u
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
hypr_sig() {
  # hyprctl instances lists only live compositors; stale $XDG_RUNTIME_DIR/hypr/*
  # dirs from earlier sessions can sort newer (phone boots with a 1970 clock),
  # and Hyprland's own /proc environ never carries the signature.
  hyprctl instances -j 2>/dev/null | python3 -c \
    'import sys,json;a=json.load(sys.stdin);print(a[0]["instance"] if a else "")' 2>/dev/null
}

for _ in $(seq 1 60); do sig=$(hypr_sig); [ -n "$sig" ] && break; sleep 1; done
export HYPRLAND_INSTANCE_SIGNATURE=$sig
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-$(ls "$XDG_RUNTIME_DIR" 2>/dev/null | grep -E '^wayland-[0-9]+$' | head -1)}
for _ in $(seq 1 30); do hyprctl version >/dev/null 2>&1 && break; sleep 1; done

ID=fajita-osk-primer
"$HOME/.local/bin/fajita-osk-primer" close    # never accumulate across restarts
uwsm-app -- foot --app-id "$ID" >/dev/null 2>&1 &
for _ in $(seq 1 20); do
  hyprctl activewindow 2>/dev/null | grep -q "class: $ID" && break
  sleep 0.5
done
sleep 1

# Park (don't close) the primer: Hyprland's relay stops routing activation once
# no text-input client exists at all, so the primer must stay alive for the
# session. On a special workspace it is invisible and costs one idle terminal.
( sleep 4; "$HOME/.local/bin/fajita-osk-primer" park ) >/dev/null 2>&1 &

exec squeekboard
