#!/bin/bash
# Bring the `ims` APN bearer's netdev up, for 81voltd.service's ExecStartPost.
# Exits 0 once the bearer is connected *and* its interface is configured,
# non-zero if the bearer never comes up (so systemd retries the unit).
#
# Why this exists: 81voltd answers the modem's QMI IMS Data request exactly
# once, with no retry, and the request arrives seconds after the service appears
# on QRTR. Started too soon after ModemManager, that single attempt returns
# `cm error: no-service` and the bearer stays down forever while the unit sits
# "active" — the same silent-failure class as q6voiced's PartOf= bug. No
# precondition predicts it reliably (gating on the modem being exported, then
# `registration-state: home`, then `state: connected` all still failed; an
# identical restart minutes later succeeds), so the working fix is to verify the
# outcome and let systemd's Restart=always try again.
set -uo pipefail
DEADLINE=${FDM_IMS_DEADLINE:-45}

# Echoes "<iface> <address> <prefix> <mtu>" for a connected `ims` bearer.
ims_bearer() {
  local b out apn conn
  for b in $(mmcli -m any -K 2>/dev/null | sed -n 's/.*bearers.value\[[0-9]*\] *: *//p'); do
    out=$(mmcli -b "$b" -K 2>/dev/null) || continue
    # -K pads keys, so trim before comparing (see README's mmcli notes).
    apn=$(sed -n 's/^bearer.properties.apn *: *//p' <<<"$out" | sed 's/ *$//')
    conn=$(sed -n 's/^bearer.status.connected *: *//p' <<<"$out" | sed 's/ *$//')
    [ "$apn" = ims ] && [ "$conn" = yes ] || continue
    printf '%s %s %s %s\n' \
      "$(sed -n 's/^bearer.status.interface *: *//p' <<<"$out" | sed 's/ *$//')" \
      "$(sed -n 's/^bearer.ipv6-config.address *: *//p' <<<"$out" | sed 's/ *$//')" \
      "$(sed -n 's/^bearer.ipv6-config.prefix *: *//p' <<<"$out" | sed 's/ *$//')" \
      "$(sed -n 's/^bearer.ipv6-config.mtu *: *//p' <<<"$out" | sed 's/ *$//')"
    return 0
  done
  return 1
}

# MM creates the bearer but configures nothing: the modem hands out a real
# IPv6 /64 for the IMS PDN and the netdev stays DOWN with no address. Inbound
# SMS still works (the modem's own IMS stack rides the PDN context), but every
# *outbound* submit times out at 25s with WmsMessageDeliveryFailure. Configuring
# this link is what makes SMSoIP submits succeed — verified: the same send goes
# from a 25s failure to rc=0 in about a second. NetworkManager must not manage
# this interface; it only ever handles qmapmux0.0 via the `three` profile.
configure() { # $1 iface, $2 address, $3 prefix, $4 mtu
  [ -n "$1" ] && [ "$1" != -- ] && [ -n "$2" ] && [ "$2" != -- ] || return 1
  ip link set "$1" up || return 1
  [ -n "$4" ] && [ "$4" != -- ] && ip link set "$1" mtu "$4" 2>/dev/null
  # Idempotent: a retry after a bearer reconnect must not fail on EEXIST.
  ip -6 addr show dev "$1" | grep -qF "$2" ||
    ip -6 addr add "$2/${3:-64}" dev "$1" || return 1
  return 0
}

for _ in $(seq 1 "$DEADLINE"); do
  if info=$(ims_bearer); then
    # shellcheck disable=SC2086 # deliberate word split: four fields
    if configure $info; then
      echo "ims bearer connected, ${info%% *} configured"
      exit 0
    fi
    echo "ims bearer connected but ${info%% *} could not be configured" >&2
    exit 1
  fi
  sleep 1
done
echo "no connected ims bearer after ${DEADLINE}s; failing so systemd retries" >&2
exit 1
