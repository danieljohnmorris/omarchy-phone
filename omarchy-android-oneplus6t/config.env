# Settings shared by every script here. Override any of these in your shell,
# or edit this file. Sourced by build-rootfs.sh, phone-setup.sh, flash.sh, shot.sh.

# Account created on the phone. The password is only ever used over the USB link
# before your ssh key is installed; change it if the phone leaves your desk.
PHONE_USER=${PHONE_USER:-dan}
PHONE_PASS=${PHONE_PASS:-fajita}
PHONE_HOSTNAME=${PHONE_HOSTNAME:-fajita}

# USB network between phone and host. The phone takes .1 and runs a DHCP server;
# the host gets an address from it. Change only if this subnet clashes with
# something on your machine.
PHONE_IP=${PHONE_IP:-172.16.42.1}
PHONE_SSH=${PHONE_SSH:-$PHONE_USER@$PHONE_IP}

# Locale and timezone written into the image.
PHONE_TZ=${PHONE_TZ:-Europe/London}
PHONE_LOCALE=${PHONE_LOCALE:-en_GB.UTF-8}
PHONE_KB_LAYOUT=${PHONE_KB_LAYOUT:-gb}

# Rootfs image size. 16G suits a 128GB phone; the image is sparse when flashed.
ROOTFS_SIZE=${ROOTFS_SIZE:-16G}

# Port used for the reverse SOCKS tunnel that gives the phone internet via the
# host: `ssh -N -R $PROXY_PORT $PHONE_SSH`
PROXY_PORT=${PROXY_PORT:-1080}
